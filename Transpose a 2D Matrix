# Program to transpose a 2D matrix using NumPy

import numpy as np

# Create a 2D array
matrix = np.array([[1, 2, 3],
                   [4, 5, 6]])

# Transpose the matrix
transpose_matrix = matrix.T

print("Original Matrix:\n", matrix)
print("Transposed Matrix:\n", transpose_matrix)
Output
Original Matrix:
 [[1 2 3]
  [4 5 6]]

Transposed Matrix:
 [[1 4]
  [2 5]
  [3 6]]

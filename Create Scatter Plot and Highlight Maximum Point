# Program to create scatter plot

import matplotlib.pyplot as plt

# Data points
x = [1, 2, 3, 4, 5]
y = [10, 25, 15, 30, 20]

# Scatter plot
plt.scatter(x, y)

# Highlight maximum point
max_y = max(y)
max_x = x[y.index(max_y)]

plt.scatter(max_x, max_y)

plt.title("Scatter Plot with Maximum Point")

plt.show()

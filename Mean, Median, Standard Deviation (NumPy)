# Program to find mean, median and standard deviation

import numpy as np

array = np.array([10, 20, 30, 40, 50])

mean_value = np.mean(array)
median_value = np.median(array)
std_value = np.std(array)

print("Mean:", mean_value)
print("Median:", median_value)

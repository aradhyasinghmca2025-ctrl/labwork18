# Program to plot two datasets

import matplotlib.pyplot as plt

# Dataset 1
x = [1, 2, 3, 4]
y1 = [2, 4, 6, 8]

# Dataset 2
y2 = [1, 3, 5, 7]

# Plot both lines
plt.plot(x, y1, label="Dataset 1")
plt.plot(x, y2, label="Dataset 2")

plt.title("Two Line Plot")

# Show legend
plt.legend()

plt.show()

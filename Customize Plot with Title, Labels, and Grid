# Program to customize plot

import matplotlib.pyplot as plt

# Monthly revenue data
months = ['Jan', 'Feb', 'Mar', 'Apr', 'May']
revenue = [2000, 2500, 2200, 2700, 3000]

# Create plot
plt.plot(months, revenue)

# Customizations
plt.title("Monthly Revenue")
plt.xlabel("Months")
plt.ylabel("Revenue")

# Add grid
plt.grid()

plt.show()
